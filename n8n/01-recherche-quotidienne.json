    {
      "id": "d2afd4cc-07cc-45dd-8e32-86ad036fa702",
      "name": "Choisir les cibles du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        100
      ],
      "parameters": {
        "jsCode": "\n// Rotation des cibles selon le jour (priorité aux lieux de réception et wedding planners).\nconst plan = {\n  1: ['salle_reception', 'wedding_planner'],\n  2: ['agence_evenementielle', 'traiteur'],\n  3: ['wedding_planner', 'comite_entreprise'],\n  4: ['salle_reception', 'hotel'],\n  5: ['agence_evenementielle', 'mairie'],\n  6: ['association', 'salon_festival'],\n  0: ['salle_reception'],\n};\nconst jour = new Date().getDay();\nconst existing = $('Lire PROSPECTS').all().map(i => i.json).filter(r => r.Entreprise);\nconst exclusions = $('Lire EXCLUSIONS').all().map(i => i.json).filter(r => r.Email || r.Domaine || r.SIREN || r.Entreprise);\n// On n'envoie que les colonnes utiles au dédoublonnage (données minimales).\nconst slim = existing.map(r => ({ Entreprise: r.Entreprise, SIREN: r.SIREN, 'Site internet': r['Site internet'], 'Email professionnel': r['Email professionnel'], 'Code postal': r['Code postal'], Ville: r.Ville }));\nreturn (plan[jour] || ['salle_reception']).map(category => ({ json: { category, maxEnrich: 15, existing: slim, exclusions } }));\n"
      }
    },
    {
      "id": "dd6736dd-1433-41fd-9ac7-c18090645934",
      "name": "Agent Recherche",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL }}/agent/research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AGENTS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "473e1e0b-afe6-4b35-bf33-2cdd8f56c043",
      "name": "Prospects retenus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "jsCode": "\nconst out = [];\nconst journal = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  for (const p of (r.prospects || [])) if (p['Score commercial'] >= 40) out.push({ json: p });\n  journal.push(`${r.categorie} p.${r.page} : ${JSON.stringify(r.stats)}${(r.errors || []).length ? ' — erreurs : ' + r.errors.slice(0, 3).join(' / ') : ''}`);\n}\n// Mémorise le journal pour le noeud suivant.\n$getWorkflowStaticData('global').dernierJournal = journal.join('\\n');\nreturn out;\n"
      }
    },
    {
      "id": "f3517bca-0fb8-4171-a1a7-561460f1ceea",
      "name": "Ajouter à PROSPECTS",
