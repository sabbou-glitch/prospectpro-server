    {
      "id": "5c322afc-44dd-4c55-8195-59c3875513e0",
      "name": "Choisir les cibles du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        100
      ],
      "parameters": {
        "jsCode": "\n// Rotation des cibles selon le jour (priorité aux lieux de réception et wedding planners).\nconst plan = {\n  1: ['salle_reception', 'wedding_planner'],\n  2: ['agence_evenementielle', 'salle_reception'],\n  3: ['wedding_planner', 'hotel'],\n  4: ['salle_reception', 'comite_entreprise'],\n  5: ['agence_evenementielle', 'mairie'],\n  6: ['salon_festival', 'association'],\n  0: ['salle_reception'],\n};\nconst jour = new Date().getDay();\nconst existing = $('Lire PROSPECTS').all().map(i => i.json).filter(r => r.Entreprise);\nconst exclusions = $('Lire EXCLUSIONS').all().map(i => i.json).filter(r => r.Email || r.Domaine || r.SIREN || r.Entreprise);\n// On n'envoie que les colonnes utiles au dédoublonnage (données minimales).\nconst slim = existing.map(r => ({ Entreprise: r.Entreprise, SIREN: r.SIREN, 'Site internet': r['Site internet'], 'Email professionnel': r['Email professionnel'], 'Code postal': r['Code postal'], Ville: r.Ville }));\nreturn (plan[jour] || ['salle_reception']).map(category => ({ json: { category, maxEnrich: 15, existing: slim, exclusions } }));\n"
      }
    },
    {
      "id": "58d27921-3185-4955-9367-44be418c47a1",
      "name": "Agent Recherche",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL }}/agent/research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AGENTS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "e0fbffe0-be07-490e-a06c-bcf3d8fea31a",
      "name": "Prospects retenus",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "jsCode": "\nconst out = [];\nconst journal = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  for (const p of (r.prospects || [])) if (p['Score commercial'] >= 40) out.push({ json: p });\n  journal.push(`${r.categorie} p.${r.page} : ${JSON.stringify(r.stats)}${(r.errors || []).length ? ' — erreurs : ' + r.errors.slice(0, 3).join(' / ') : ''}`);\n}\n// Mémorise le journal pour le noeud suivant.\n$getWorkflowStaticData('global').dernierJournal = journal.join('\\n');\nreturn out;\n"
      }
    },
    {
