        "jsCode": "\nconst d = $getWorkflowStaticData('global').dernierJournal || '';\nreturn [{ json: { Date: new Date().toISOString(), Agent: 'recherche', Action: 'recherche_quotidienne', Détail: d, 'Coût (€)': '', Statut: 'ok' } }];\n"
      },
