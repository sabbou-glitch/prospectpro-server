    {
      "id": "51e73fe5-0719-4e09-958e-74e4063215f9",
      "name": "Réponses de prospects",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        250
      ],
      "parameters": {
        "jsCode": "\nconst norm = (s) => String(s || '').toLowerCase().trim();\nconst addr = (v) => { if (!v) return ''; if (typeof v === 'string') { const m = v.match(/<([^>]+)>/); return norm(m ? m[1] : v); }\n  if (v.value && v.value[0]) return norm(v.value[0].address); return ''; };\nconst allAddr = (v) => { if (!v) return []; if (typeof v === 'string') return v.split(',').map(addr); if (v.value) return v.value.map(x => norm(x.address)); return []; };\nconst today = new Date().toISOString().slice(0, 10);\nconst prospects = $('Lire PROSPECTS').all().map(i => i.json).filter(r => r.ID);\nconst byEmail = {}; const byDomain = {};\nconst PERSO = /@(gmail|yahoo|hotmail|outlook|live|orange|free|sfr|laposte|wanadoo|icloud|aol)\\./;\nfor (const p of prospects) { const e = norm(p['Email professionnel']); if (!e) continue; byEmail[e] = p; if (!PERSO.test(e)) byDomain[e.split('@')[1]] = p; }\nconst dejaVu = new Set($('Lire CONTACTS').all().map(i => String(i.json['Gmail thread ID'] || '')).filter(Boolean));\nconst find = (e) => byEmail[e] || byDomain[(e.split('@')[1] || '')];\n\n// Emails reçus d'un prospect connu, pas encore analysés.\nconst out = [];\nfor (const m of $('Gmail : messages reçus').all().map(i => i.json)) {\n  if (!m.id || dejaVu.has(m.id)) continue;\n  const from = addr(m.from || m.From); const p = find(from); if (!p) continue;\n  out.push({ json: { from, subject: m.subject || m.Subject || '', text: (m.text || m.snippet || '').slice(0, 4000), gmailId: m.id, prospectId: p.ID, entreprise: p.Entreprise } });\n}\nreturn out;\n"
      },
      "executeOnce": true
    },
    {
      "id": "a4ccdf15-ec90-4a19-a18e-77b82cdb178c",
      "name": "Analyse IA réponse",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1550,
        250
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL }}/agent/reply",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AGENTS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "25edbc0c-44ca-419a-8f9a-db90d1bda1de",
      "name": "Décisions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        250
      ],
      "parameters": {
        "jsCode": "\nconst src = $('Réponses de prospects').all();\nconst today = new Date().toISOString().slice(0, 10);\nreturn $input.all().map((it, i) => {\n  const a = it.json; const m = src[i].json;\n  const oppose = a.categorie === 'opposition';\n  const statut = oppose ? 'refus' : (a.categorie === 'pas_interesse' ? 'refus' : (['absence_auto', 'mauvais_contact'].includes(a.categorie) ? 'contacte' : 'repondu'));\n  const action = oppose ? '' : ({ interesse: 'rappeler', demande_devis: 'preparer_devis', demande_info: 'envoyer_plaquette', plus_tard: 'relancer_plus_tard', pas_interesse: '' }[a.categorie] ?? 'lire_reponse');\n  return { json: {\n    contact: { Date: new Date().toISOString(), 'ID prospect': m.prospectId, Entreprise: m.entreprise, Email: m.from, Direction: 'entrant', Type: 'email', Objet: m.subject, Résumé: a.resume, 'Catégorie réponse': a.categorie, 'Gmail thread ID': m.gmailId, Campagne: '', Agent: 'suivi_reponses', 'Suite donnée': a.action_recommandee },\n    maj: Object.assign({ ID: m.prospectId, Statut: statut, 'Date du dernier contact': today, 'Prochaine action': action }, oppose ? { 'Opposition à la prospection': 'oui' } : {}),\n    exclusion: oppose ? { Date: new Date().toISOString(), Email: m.from, Domaine: '', Entreprise: m.entreprise, SIREN: '', Motif: 'Opposition à la prospection', 'Source de la demande': `Email du ${today}` } : null,\n  } };\n});\n"
      }
    },
