    {
      "id": "e36c5013-a7e5-4340-97af-9f356929f919",
      "name": "Lire EXCLUSIONS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        500,
        100
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
