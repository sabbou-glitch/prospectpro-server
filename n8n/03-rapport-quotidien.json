    {
      "id": "dcd94a55-af82-4e8e-b491-c78322324492",
      "name": "Assembler les données",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "jsCode": "\nconst rows = (n) => $(n).all().map(i => i.json).filter(r => Object.keys(r).length > 1);\nreturn [{ json: { prospects: rows('Lire PROSPECTS'), contacts: rows('Lire CONTACTS'), devis: rows('Lire DEVIS'),\n  erreurs: rows('Lire JOURNAL').filter(j => j.Statut === 'erreur' && String(j.Date).startsWith(new Date().toISOString().slice(0,10))).map(j => j.Détail) } }];\n"
      }
    },
    {
      "id": "ec9878c4-3262-42dd-b3e9-41e3de2aa5b2",
      "name": "Directeur IA - rapport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL }}/agent/report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AGENTS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      }
    },
    {
      "id": "f586ff25-c360-4d50-b0f2-05bfb0ca94b2",
      "name": "Envoyer le rapport",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1750,
        100
      ],
      "parameters": {
        "sendTo": "={{ $env.REPORT_TO }}",
        "subject": "={{ $json.sujet }}",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      }
    }
  ],
