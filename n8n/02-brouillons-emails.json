    {
      "id": "dc45b05e-ade5-4203-910c-426b576b024d",
      "name": "Lire EXCLUSIONS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        500,
        100
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "EXCLUSIONS",
          "mode": "name"
        },
        "options": {}
      }
    },
    {
      "id": "4551a2f0-5c4e-409d-aef3-4ccbb64a2f98",
      "name": "Sélection du jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        750,
        100
      ],
      "parameters": {
        "jsCode": "\n// Sélectionne au maximum 10 prospects/jour (montée en charge progressive), score >= 60, avec email.\nconst MAX_PAR_JOUR = 10;\nconst rows = $('Lire PROSPECTS').all().map(i => i.json);\nconst exclusions = $('Lire EXCLUSIONS').all().map(i => i.json).filter(r => r.Email || r.Domaine || r.SIREN || r.Entreprise);\nconst cibles = rows\n  .filter(r => r['Prochaine action'] === 'rediger_email' && r['Statut'] === 'nouveau')\n  .filter(r => Number(r['Score commercial']) >= 60 && r['Email professionnel'] && String(r['Opposition à la prospection']).toLowerCase() !== 'oui')\n  .sort((a, b) => Number(b['Score commercial']) - Number(a['Score commercial']))\n  .slice(0, MAX_PAR_JOUR);\nif (!cibles.length) return [];\nreturn [{ json: { prospects: cibles, exclusions, max: MAX_PAR_JOUR } }];\n"
      }
    },
    {
      "id": "4d4618c3-fdbd-47df-9225-dfec84353db0",
      "name": "Agent Prospection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AGENTS_URL }}/agent/draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.AGENTS_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 600000
        }
      }
    },
    {
      "id": "649c0ff4-0585-43b1-905c-9265263baf00",
      "name": "Un brouillon par ligne",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        100
      ],
      "parameters": {
        "jsCode": "\nconst out = [];\nfor (const b of ($input.first().json.brouillons || [])) out.push({ json: b });\nreturn out;\n"
      }
    },
    {
      "id": "a1fb926e-a299-43a7-8042-1a461470f455",
      "name": "Brouillons conformes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        100
      ],
      "parameters": {
        "jsCode": "\n// Seuls les brouillons conformes partent dans Gmail ; les autres sont signalés dans le journal.\nreturn $input.all().filter(i => i.json.ok && i.json.to);\n"
      }
    },
    {
      "id": "93d563da-6dc0-474a-9d99-a3e4f824fe1a",
      "name": "Créer brouillon Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1750,
        100
      ],
      "parameters": {
        "resource": "draft",
        "subject": "={{ $json.objet }}",
        "emailType": "text",
        "message": "={{ $json.corps }}",
        "options": {
          "sendTo": "={{ $json.to }}"
        }
      }
    },
    {
      "id": "d8cb623c-d3c6-4b95-a32b-965d21a5f4f4",
      "name": "Préparer mise à jour",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        0
      ],
      "parameters": {
        "jsCode": "\nconst today = new Date().toISOString().slice(0, 10);\nreturn $('Brouillons conformes').all().map(i => ({ json: { ID: i.json.id, Statut: 'brouillon_pret', 'Prochaine action': 'valider_et_envoyer', 'Date du dernier contact': '' } }));\n"
      },
      "executeOnce": true
    },
    {
      "id": "24a54f38-92dc-4307-8115-b9767802ff2b",
      "name": "Mettre à jour PROSPECTS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
