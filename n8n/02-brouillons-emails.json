    {
      "id": "97019366-f21a-4432-af23-aa6718f7a68a",
      "name": "Préparer historique",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        250
      ],
      "parameters": {
        "jsCode": "\nconst drafts = $('Brouillons conformes').all();\nreturn drafts.map((d, idx) => ({ json: {\n  Date: new Date().toISOString(), 'ID prospect': d.json.id, Entreprise: '', Email: d.json.to, Direction: 'sortant',\n  Type: 'brouillon', Objet: d.json.objet, Résumé: `Accroche : ${d.json.accroche} — prestation : ${d.json.prestation}`,\n  'Catégorie réponse': '', 'Gmail thread ID': ($('Créer brouillon Gmail').all()[idx] || { json: {} }).json.id || '',\n  Campagne: 'premier-contact', Agent: 'prospection', 'Suite donnée': 'à valider par le dirigeant' } }));\n"
      },
      "executeOnce": true
    },
