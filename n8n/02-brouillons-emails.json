    {
      "id": "35b4b4b4-6641-4f92-9a57-63bb86f85330",
      "name": "Lire PROSPECTS",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        250,
        100
      ],
      "alwaysOutputData": true,
      "executeOnce": true,
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "={{ $env.GOOGLE_SHEET_ID }}",
