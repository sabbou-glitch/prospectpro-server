# Copier ce fichier en ".env" (cp .env.example .env) puis remplir les valeurs.
# Le fichier .env n'est JAMAIS envoyé sur GitHub (.gitignore).

# --- Serveur des agents ---
PORT=3000
# Jeton partagé entre n8n et le serveur. Générer avec : openssl rand -hex 32
SERVER_API_TOKEN=

# --- Claude API (https://console.anthropic.com/settings/keys) ---
ANTHROPIC_API_KEY=
MODEL_QUALIFY=claude-haiku-5-5
MODEL_DRAFT=claude-opus-5-5
MODEL_DRAFT_EFFORT=low

# --- Google Places API (New) — NOUVELLE clé, restreinte à "Places API (New)" ---
GOOGLE_PLACES_API_KEY=
PLACES_MONTHLY_LIMIT=900

# --- Garde-fous budgétaires ---
BUDGET_MONTHLY_CAP_EUR=15
BUDGET_ALERT_RATIO=0.7
RESEARCH_MAX_ENRICH_PER_RUN=15
RESEARCH_MIN_SCORE=40

# --- Expéditeur (signature des emails) ---
SENDER_NAME=
SENDER_EMAIL=
SENDER_PHONE=
SENDER_WEBSITE=
VENDEUR_ADRESSE=

# --- n8n ---
GOOGLE_SHEET_ID=
REPORT_TO=
N8N_ENCRYPTION_KEY=
# Mettre "true" pour suspendre toutes les actions des agents (arrêt d'urgence).
AGENTS_PAUSED=false
